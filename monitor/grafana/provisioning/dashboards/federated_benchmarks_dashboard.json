          "refId": "A"
        }
      ],
      "title": "⏱️ Deliberation & Round Table Stage Durations",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "moe_router_latency_seconds",
          "legendFormat": "{{start_type}}",
          "refId": "A"
        }
      ],
      "title": "🧭 Intent Routing & Triage Latency Heatmap",
      "type": "heatmap"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "id": 7,
      "targets": [
        {
          "expr": "moe_model_ttft_seconds",
          "legendFormat": "TTFT (Time to First Token)",
          "refId": "A"
        },
        {
          "expr": "moe_model_itl_seconds",
          "legendFormat": "ITL (Inter-Token Latency)",
          "refId": "B"
        }
      ],
      "title": "📊 Time to First Token (TTFT) vs Inter-Token Latency (ITL)",
      "type": "boxplot"
    }
